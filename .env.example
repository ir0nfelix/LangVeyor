# PostgreSQL 17 (MES Domain DB + LangGraph AsyncPostgresSaver)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=langveyor
POSTGRES_PASSWORD=langveyor
POSTGRES_DB=langveyor
DATABASE_URL=postgresql+asyncpg://langveyor:langveyor@localhost:5432/langveyor
CHECKPOINTER_DSN=postgresql://langveyor:langveyor@localhost:5432/langveyor

# Qdrant Vector Store & Local CPU Embeddings
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_COLLECTION=mes_sops
EMBEDDING_MODEL=cointegrated/LaBSE-en-ru
EMBEDDING_DEVICE=cpu

# OpenRouter LLM Configuration (4 separate roles; Auditor and Judge use separate model families from Investigator)
# Verified against https://openrouter.ai/api/v1/models (tools + structured_outputs supported)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_INVESTIGATOR=deepseek/deepseek-v3.2
OPENROUTER_MODEL_AUDITOR=openai/gpt-4.1-mini
OPENROUTER_MODEL_JUDGE=anthropic/claude-haiku-4.5

# Agent & RAG Tuning
MAX_TOOL_STEPS=8
MAX_REVISIONS=2
RAG_TOP_K=5
RAG_DENSE_WEIGHT=0.55
RAG_BM25_WEIGHT=0.45
SAMPLING_HMAC_SECRET=langveyor-alg001-deterministic-seed-2026
