        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Auditor" name="Ревизор и Веб-поиск">
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_web</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Verdict" name="Вердикт и HITL Postgres">
        <bpmn:flowNodeRef>t_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hitl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_hitl</bpmn:flowNodeRef>
