        <bpmn:flowNodeRef>e_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Запрос из парка">
      <bpmn:outgoing>flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_intake" name="Разбор жалобы (Intake)">
      <bpmn:incoming>flow0</bpmn:incoming>
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_serial" name="Серийник?" default="flow3">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
      <bpmn:outgoing>flow3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_triage" name="Триаж BPMN и Qdrant RAG">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_clarify" name="Запрос серийника">
      <bpmn:incoming>flow3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_gen" name="Генеалогия и история">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_found" name="В MES?" default="flow7">
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
      <bpmn:outgoing>flow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_inconcl" name="Статус INCONCLUSIVE">
      <bpmn:incoming>flow7</bpmn:incoming>
      <bpmn:outgoing>flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_sym" name="Симптом?" default="flow11">
