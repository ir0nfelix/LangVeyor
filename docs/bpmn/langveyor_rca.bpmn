  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="LangVeyor" name="MES RCA: Расследование обращений парка" processRef="Process_1_0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1_0" isExecutable="true">
    <bpmn:laneSet id="laneSet0">
      <bpmn:lane id="L_Intake" name="Приём и триаж (FAST)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_serial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Investigator" name="Следователь и MES SQL">
        <bpmn:flowNodeRef>t_gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inconcl</bpmn:flowNodeRef>
